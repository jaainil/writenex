{
  "name": "writenex-monorepo",
  "private": true,
  "description": "Writenex monorepo - Modern WYSIWYG Markdown editor",
  "homepage": "https://writenex.com",
  "license": "MIT",
  "author": "Erland <hello@erland.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaainil/writenex.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:writenex": "pnpm --filter writenex dev",
    "build": "turbo build",
    "build:writenex": "turbo build --filter writenex",
    "build:astro": "turbo build --filter @imjp/writenex-astro",
    "lint": "vp lint && vp run lint:biome",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "validate": "vp check && vp run lint:biome",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "lint:biome": "turbo lint",
    "check": "vp check",
    "pack": "vp -C packages/astro pack",
    "test:consumer": "node packages/astro/tests/consumer/check.mjs",
    "build:next": "turbo build --filter @imjp/writenex-next",
    "test:next-consumer": "node packages/next/tests/consumer/check.mjs"
  },
  "dependencies": {
    "pnpm": "^11.24.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.15.1"
}
